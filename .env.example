GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional LLM fallbacks
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_openrouter_free_model:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENWEATHER_API_KEY=your_openweather_api_key

PLANNING_USE_LLM=true
LANGCHAIN_TRACING_V2=false

# Docker runtime networking
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ChromaDB service inside docker-compose network
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_URL=http://chromadb:8000

# App-local fallback vector path for the current codebase
VECTOR_DB_PATH=/app/vector_db
