GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL runtime
POSTGRES_DB=vivu
POSTGRES_USER=vivu
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=vivu
DATABASE_USER=vivu
DATABASE_PASSWORD=change_this_postgres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60
SQLITE_DB_PATH=vivu_backend/vivudb.sqlite3

# Optional LLM fallbacks
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_openrouter_free_model:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENWEATHER_API_KEY=your_openweather_api_key
GOOGLE_API_KEY=your_google_api_key

PLANNING_USE_LLM=true
LANGCHAIN_TRACING_V2=false

# Docker runtime networking
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ChromaDB service inside docker-compose network
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_URL=http://chromadb:8000
CHROMA_PERSIST_DIRECTORY=vivu_backend/vector_db

# App-local fallback vector path for the current codebase
VECTOR_DB_PATH=/app/vector_db
